# Git ignore for NutriAI monorepo

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
service-account*.json
firebase-adminsdk*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
ENV/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# Logs & temp
*.log
logs/
temp/
tmp/
storage/reports/*
!storage/reports/.gitkeep

# IDE & OS
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

