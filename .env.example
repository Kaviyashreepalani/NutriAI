# Environment variables for NutriAI
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# --- Application Environment ---
# Environment: development, staging, production
APP_ENV=development
# Debug mode (true/false)
DEBUG=true
# Application secret key for JWT session tokens and encryption
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-prod
# Column encryption key (AES-256-GCM requires a 32-byte base64 encoded key)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=dGhpc2lzYTMyeWVhcmxvbmctc2VjcmV0LWtleS1mb3ItZGV2

# --- Platform & Provider Configuration ---
# Data platform options: supabase, docker, firebase_storage
DATA_PLATFORM=supabase
# Auth provider options: supabase, firebase, dev (dev only allowed when APP_ENV=development)
AUTH_PROVIDER=dev
# Storage provider options: supabase, s3, firebase
STORAGE_PROVIDER=s3

# --- Database (PostgreSQL 15+) ---
# Note: SQLite is NOT allowed. Use PostgreSQL for relational constraints, pg_trgm and JSONB.
# Pooled connection string used by FastAPI application runtime
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nutriai
# Direct connection string used by Alembic migrations (without pgbouncer pooling)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nutriai

# --- Supabase Configuration (Used when DATA_PLATFORM=supabase or AUTH_PROVIDER=supabase) ---
# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://placeholder.supabase.co
# Supabase Anon Public Key (safe for frontend public requests)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
# Supabase Service Role Key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service-role-placeholder
# Supabase JWT Secret for backend token validation
SUPABASE_JWT_SECRET=super-secret-jwt-token-string-from-supabase-dashboard
# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_REPORTS=reports
SUPABASE_STORAGE_BUCKET_IMAGES=product-images

# --- Firebase Configuration (Used when AUTH_PROVIDER=firebase or DATA_PLATFORM=firebase_storage) ---
# Firebase Project ID
FIREBASE_PROJECT_ID=nutriai-demo-firebase
# Path to service account JSON file, or inline JSON string
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Storage Bucket name
FIREBASE_STORAGE_BUCKET=nutriai-demo.appspot.com

# --- S3 / MinIO Configuration (Used when STORAGE_PROVIDER=s3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nutriai-reports
S3_REGION=us-east-1

# --- LLM Provider Configuration ---
# Options: mock, gemini, anthropic
LLM_PROVIDER=mock
# Google Gemini API key
GEMINI_API_KEY=
# Anthropic Claude API key
ANTHROPIC_API_KEY=

# --- Speech Provider Configuration ---
# STT / TTS options: browser (client-side Web Speech), google, bhashini, mock
SPEECH_PROVIDER=mock
# Google Cloud Speech credentials path (if using google)
GOOGLE_APPLICATION_CREDENTIALS=
# Bhashini API Key and User ID (if using bhashini)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- OCR Feature Flags & Thresholds ---
ENABLE_LLM_OCR_FALLBACK=false
OCR_CONFIDENCE_THRESHOLD=0.75

# --- Policy & Medical Safety Flags ---
# Allow food recommendation with medical referral banner if true; if false, referral blocks recommendation
ALLOW_GENERATION_WITH_REFERRAL=true
# Default iron delivery benchmark (mg per serving)
DEFAULT_IRON_TARGET_MIN_MG=4.0
DEFAULT_IRON_TARGET_MAX_MG=5.0

# --- Frontend URLs & CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

